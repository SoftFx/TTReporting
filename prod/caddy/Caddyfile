{
    auto_https off
}

# Users are defined in users.caddyfile (gitignored)
import users.caddyfile

:80 {
    redir https://{host}{uri} permanent
}

# ── Statements (SeaweedFS S3 gateway) — key-based download access ──
# Own port, not a path under :443 -- S3 SigV4 signs the full request path,
# so nesting this under e.g. /s3/* on :443 would make Caddy's uri strip_prefix
# desync the path the client signed from the path SeaweedFS verifies, and
# every request would fail with SignatureDoesNotMatch regardless of correct
# keys (confirmed by testing). No basic_auth here on purpose: auth is the S3
# access/secret key itself, verified by SeaweedFS's own S3 gateway
# (seaweedfs/s3.json). Caddy just terminates TLS and proxies as-is.
:8333 {
    tls /srv/certs/server.crt /srv/certs/server.key
    reverse_proxy seaweedfs:8333
}

:443 {
    tls /srv/certs/server.crt /srv/certs/server.key

    # ── Security headers ──────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline' 'self'; connect-src 'self' wss: ws:; font-src 'self' data:; img-src 'self' data: blob:;"
    }

    # ── Rate limiting (requires caddy-ratelimit plugin) ──
    # Uncomment after building a custom Caddy image with the plugin:
    # rate_limit {
    #     zone auth_zone {
    #         key {remote_host}
    #         events 20
    #         window 60s
    #     }
    # }

    root * /srv/home

    # ── Home page — all authenticated users ──────
    @homepage path / /index.html
    handle @homepage {
        basic_auth {
            import all-users
        }
        file_server {
            index index.html
        }
    }

    # ── Static assets (vendored JS) ─────────────
    handle /static/* {
        basic_auth {
            import all-users
        }
        file_server
    }

    # ── Download root CA certificate (public) ────
    handle /root-ca.crt {
        file_server
    }

    # ── products.yaml (same auth as home) ────────
    handle /products.yaml {
        basic_auth {
            import all-users
        }
        file_server
    }

    # ── Aggregator Data ─────────────────────────
    handle /aggr-data/* {
        basic_auth {
            import admin_creads
            import aggr-data-users
        }
        uri strip_prefix /aggr-data
        reverse_proxy aggr-data-app:3838
    }

    # ── User Analytics ─────────────────────────
    handle /user-data/* {
        basic_auth {
            import admin_creads
            import user-data-users
        }
        uri strip_prefix /user-data
        reverse_proxy user-data-app:3838
    }

    # ── Statements (SeaweedFS) — read-only, GET/HEAD only ──
    # Two buckets in the filer: /buckets/statements (ttlive, ttliveUK, ttliveEU) and
    # /buckets/statements-prom (ttlivePROM -- separate product, separate S3 key; buckets must
    # physically live under /buckets/<name>, this version of SeaweedFS has no option to relocate
    # that root). We proxy the SAME paths externally (no uri rewriting) because SeaweedFS's own
    # folder-browser HTML generates links using its real internal path -- a rewritten external
    # prefix would only fix the first request; every link the browser then clicks would go
    # straight to /buckets/... and miss the route entirely (confirmed by testing).
    #
    # /statements/ (the home-page card) opens /buckets/ -- the folder that shows both buckets.
    # Older deep bookmarks /statements/<domain>/... still land in the first bucket.
    handle /statements/* {
        basic_auth {
            import admin_creads
            import statements-users
        }
        handle /statements/ {
            redir * /buckets/ 302
        }
        handle {
            redir * /buckets{uri} 302
        }
    }

    # Only the bucket list itself and these two buckets are reachable -- any other bucket
    # created later shows up by name in the /buckets/ listing but is not served until it is
    # added here on purpose.
    @statement_buckets path /buckets/ /buckets/statements/* /buckets/statements-prom/*
    handle @statement_buckets {
        @notget {
            not method GET HEAD
        }
        respond @notget 405

        basic_auth {
            import admin_creads
            import statements-users
        }
        reverse_proxy seaweedfs:8888
    }

    # ── SeaweedFS filer's own static assets (CSS/logo for its folder-browser UI) ──
    # Not sensitive (just Bootstrap CSS + a logo image), so no auth needed -- this only fixes
    # the cosmetic styling of the folder listing, the actual statement files never depend on it.
    handle /seaweedfsstatic/* {
        reverse_proxy seaweedfs:8888
    }

    # ── Catch-all: deny unmatched paths ──────────
    handle {
        respond 403
    }

    log {
        output stdout
        format json
    }
}
